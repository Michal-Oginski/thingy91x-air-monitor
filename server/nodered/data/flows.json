  {
    "id": "env_fn",
    "type": "function",
    "z": "tab_env",
    "name": "BME688 readings and location",
    "func": "const p = msg.payload;\nif (!p || typeof p !== \"object\") {\n    node.warn(\"Invalid environment payload\");\n    return null;\n}\n\nconst device = (msg.topic || \"\").split(\"/\")[1] || \"thingy91x\";\nconst now = new Date();\nconst when = now.toLocaleString(\"en-GB\", { timeZone: \"Europe/Warsaw\" });\nconst temperature = Number(p.temperature);\nconst pressure = Number(p.pressure);\nconst humidity = Number(p.humidity);\nconst gasResistance = Number(p.gas_resistance);\n\nif (p.status !== \"ok\" || ![temperature, pressure, humidity, gasResistance].every(Number.isFinite)) {\n    const reason = p.status && p.status !== \"ok\" ? p.status : \"invalid sensor values\";\n    node.status({ fill: \"red\", shape: \"ring\", text: reason });\n    return [null, null, null, null, { payload: `BME688 status: ${reason}` }, null];\n}\n\nconst lat = Number(p.lat);\nconst lon = Number(p.lon);\nconst sources = { manual: \"Manual\", wifi: \"Wi-Fi\", gnss: \"GPS\", cell: \"Cell towers\" };\nif (Number.isFinite(lat) && Number.isFinite(lon) && !(lat === 0 && lon === 0)) {\n    flow.set(\"loc_\" + device, {\n        lat,\n        lon,\n        acc: Number(p.acc) || null,\n        time: when,\n        src: sources[p.loc] || \"GPS\"\n    });\n}\n\nconst loc = flow.get(\"loc_\" + device);\nconst marker = loc ? { payload: {\n    name: device,\n    lat: loc.lat,\n    lon: loc.lon,\n    accuracy: loc.acc || undefined,\n    icon: \"fa-cloud\",\n    iconColor: \"blue\",\n    label: `${device}: ${temperature.toFixed(1)} C`,\n    temperature: `${temperature.toFixed(2)} C`,\n    pressure: `${pressure.toFixed(2)} kPa`,\n    humidity: `${humidity.toFixed(1)} %`,\n    gas_resistance: `${gasResistance.toFixed(0)} ohm`,\n    status: \"OK\",\n    location: loc.src,\n    last_fix: loc.time,\n    fix_age: p.fix_age\n} } : null;\n\nif (marker) flow.set(\"last_marker\", marker.payload);\nconst mapMsgs = marker ? [\n    marker,\n    { payload: { command: { lat: loc.lat, lon: loc.lon, zoom: 16 } } }\n] : null;\n\nnode.status({ fill: \"green\", shape: \"dot\", text: `${temperature.toFixed(1)} C / ${humidity.toFixed(0)} %` });\nreturn [\n    { payload: temperature, topic: \"Temperature\" },\n    { payload: pressure, topic: \"Pressure\" },\n    { payload: humidity, topic: \"Humidity\" },\n    { payload: gasResistance, topic: \"Gas resistance\" },\n    { payload: `Updated ${when}` },\n    mapMsgs\n];",
    "outputs": 6,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 400,
    "y": 160,
    "wires": [
      [
        "env_temperature",
        "env_temperature_chart"
      ],
      [
        "env_pressure",
        "env_pressure_chart"
      ],
      [
        "env_humidity",
        "env_humidity_chart"
      ],
      [
        "env_gas_resistance"
      ],
      [
        "env_status"
      ],
      [
        "sensor_map"
      ]
    ],
    "outputLabels": [
      "Temperature",
      "Pressure",
      "Humidity",
      "Gas resistance",
      "Status",
      "Map marker"
    ]
