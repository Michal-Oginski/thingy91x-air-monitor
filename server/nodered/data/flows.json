        "id": "env_in",
        "type": "mqtt in",
        "z": "tab_env",
        "name": "Thingy:91 X onboard environment",
        "topic": "sensors/+/env",
        "qos": "1",
        "datatype": "json",
        "broker": "broker",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 150,
        "y": 160,
        "wires": [
            [
                "env_fn",
                "env_watchdog",
                "env_debug"
            ]
        ]
    },
    {
        "id": "env_fn",
        "type": "function",
        "z": "tab_env",
        "name": "BME688 readings and location",
        "func": "const p = msg.payload;\nif (!p || typeof p !== \"object\") {\n    node.warn(\"Invalid environment payload\");\n    return null;\n}\n\nconst device = (msg.topic || \"\").split(\"/\")[1] || \"thingy91x\";\nconst when = new Date().toLocaleString(\"en-GB\", { timeZone: \"Europe/Warsaw\" });\nconst temperature = Number(p.temperature);\nconst pressure = Number(p.pressure);\nconst humidity = Number(p.humidity);\nconst gasResistance = Number(p.gas_resistance);\n\nif (p.status !== \"ok\" || ![temperature, pressure, humidity, gasResistance].every(Number.isFinite)) {\n    const reason = p.status && p.status !== \"ok\" ? p.status : \"invalid sensor values\";\n    node.status({ fill: \"red\", shape: \"ring\", text: reason });\n    return [null, null, null, null, {\n        payload: { online: true, sensorStatus: reason, updated: when }\n    }, null, null];\n}\n\nconst lat = Number(p.lat);\nconst lon = Number(p.lon);\nconst sources = { manual: \"Manual\", wifi: \"Wi-Fi\", gnss: \"GPS\", cell: \"Cell towers\" };\nif (Number.isFinite(lat) && Number.isFinite(lon) && !(lat === 0 && lon === 0)) {\n    flow.set(\"loc_\" + device, {\n        lat,\n        lon,\n        acc: Number(p.acc) || null,\n        time: when,\n        src: sources[p.loc] || \"GPS\"\n    });\n}\n\nconst loc = flow.get(\"loc_\" + device);\nconst marker = loc ? { payload: {\n    name: device,\n    lat: loc.lat,\n    lon: loc.lon,\n    accuracy: loc.acc || undefined,\n    icon: \"fa-cloud\",\n    iconColor: \"blue\",\n    label: `${device}: ${temperature.toFixed(1)} C`,\n    temperature: `${temperature.toFixed(2)} C`,\n    pressure: `${pressure.toFixed(2)} kPa`,\n    humidity: `${humidity.toFixed(1)} %`,\n    gas_resistance: `${gasResistance.toFixed(0)} ohm`,\n    status: \"OK\",\n    location: loc.src,\n    last_fix: loc.time,\n    fix_age: p.fix_age\n} } : null;\n\nif (marker) flow.set(\"last_marker\", marker.payload);\nconst mapMsgs = marker ? [\n    marker,\n    { payload: { command: { lat: loc.lat, lon: loc.lon, zoom: 16 } } }\n] : null;\n\nnode.status({ fill: \"green\", shape: \"dot\", text: `${temperature.toFixed(1)} C / ${humidity.toFixed(0)} %` });\nreturn [\n    { payload: temperature, topic: \"Temperature\" },\n    { payload: pressure, topic: \"Pressure\" },\n    { payload: humidity, topic: \"Humidity\" },\n    {\n        payload: gasResistance,\n        display: gasResistance >= 1000 ? `${(gasResistance / 1000).toFixed(1)}k` : gasResistance.toFixed(0),\n        topic: \"Gas resistance\"\n    },\n    { payload: { online: true, sensorStatus: \"ok\", updated: when } },\n    mapMsgs,\n    { payload: loc ? { source: loc.src === \"Cell towers\" ? \"Cell\" : loc.src, coordinates: `${loc.lat.toFixed(5)}, ${loc.lon.toFixed(5)}` } : null }\n];",
        "outputs": 7,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 160,
        "wires": [
            [
                "env_temperature",
                "env_temperature_chart"
            ],
            [
                "env_pressure"
            ],
            [
                "env_humidity"
            ],
            [
                "env_gas_resistance"
            ],
            [
                "env_status"
            ],
            [
                "sensor_map"
            ],
            [
                "env_location_status"
            ]
        ],
        "outputLabels": [
            "Temperature",
            "Pressure",
            "Humidity",
            "Gas resistance",
            "Device status",
            "Map marker",
            "Location status"
        ]
    },
    {
        "id": "env_status",
        "type": "ui_template",
        "z": "tab_env",
        "group": "iaq_grp",
        "name": "Device header and connection status",
        "order": 1,
        "width": 16,
        "height": 2,
        "format": "<div style=\"box-sizing:border-box;width:100%;min-height:54px;padding:2px 4px 8px;display:flex;align-items:flex-start;justify-content:space-between;font-family:inherit;color:#e8eef5;\">\n  <div>\n    <div style=\"font-size:20px;font-weight:700;letter-spacing:.3px;\">THINGY:91 X</div>\n    <div style=\"margin-top:5px;font-size:14px;color:#aab8c5;letter-spacing:.35px;\">ENVIRONMENT MONITOR · LIVE TELEMETRY</div>\n    <div ng-if=\"msg.payload && msg.payload.updated\" style=\"margin-top:3px;font-size:13px;color:#73879a;\">Last update: {{msg.payload.updated}}</div>\n    <div ng-if=\"msg.payload && msg.payload.message\" style=\"margin-top:3px;font-size:14px;color:#fca5a5;\">{{msg.payload.message}}</div>\n    <div ng-if=\"msg.payload && msg.payload.sensorStatus && msg.payload.sensorStatus !== 'ok' && msg.payload.sensorStatus !== 'offline'\" style=\"margin-top:3px;font-size:14px;color:#fbbf24;\">BME688: {{msg.payload.sensorStatus}}</div>\n  </div>\n  <div ng-class=\"(msg.payload && msg.payload.online) ? 'online-badge online' : 'online-badge offline'\" style=\"display:flex;align-items:center;gap:6px;margin-top:1px;padding:4px 9px;border-radius:12px;font-size:14px;font-weight:700;\">\n    <span style=\"width:7px;height:7px;border-radius:50%;background:currentColor;\"></span>\n    {{msg.payload && msg.payload.online ? 'ONLINE' : 'OFFLINE'}}\n  </div>\n</div>\n<style>\n.online-badge.online{color:#22c55e;background:rgba(34,197,94,.12)}\n.online-badge.offline{color:#ef4444;background:rgba(239,68,68,.12)}\n</style>",
        "storeOutMessages": true,
        "fwdInMessages": false,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "telemetry-header",
        "x": 930,
        "y": 380,
        "wires": [
            []
        ]
    },
