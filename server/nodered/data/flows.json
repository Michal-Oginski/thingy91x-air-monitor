  {
    "id": "env_in",
    "type": "mqtt in",
    "z": "tab_env",
    "name": "Thingy:91 X onboard environment",
    "topic": "sensors/+/env",
    "qos": "1",
    "datatype": "json",
    "broker": "broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 150,
    "y": 160,
    "wires": [
