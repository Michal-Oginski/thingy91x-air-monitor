  {
    "id": "map_reconnect_fn",
    "type": "function",
    "z": "tab_env",
    "name": "Redraw + centre",
    "func": "// A browser opened the map: redraw the last marker and centre on it\nif (!msg.payload || msg.payload.action !== \"connected\") return null;\nconst m = flow.get(\"last_marker\");\nif (!m) return null;\nreturn [[\n    { payload: m, _sessionid: msg._sessionid },\n    { payload: { command: { lat: m.lat, lon: m.lon, zoom: 16 } }, _sessionid: msg._sessionid }\n]];",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
