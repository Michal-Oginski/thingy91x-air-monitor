menu "Thingy:91 X air monitor"

config APP_MQTT_HOST
	string "MQTT broker hostname"
	default "srv72.mikr.us"

config APP_MQTT_PORT
	int "MQTT broker port (TLS)"
	default 40022

config APP_MQTT_USER
	string "MQTT username"
	default "thingy91x"

config APP_MQTT_PASSWORD
	string "MQTT password (set this in secrets.conf, never commit it)"
	default ""

config APP_MQTT_TOPIC
	string "Environment publish topic"
	default "sensors/thingy91x/env"

config APP_MQTT_KEEPALIVE_S
	int "MQTT keepalive (seconds)"
	default 120

config APP_SEC_TAG
	int "Modem security tag used for the broker CA certificate"
	default 4242

config APP_ENV_PUBLISH_INTERVAL_S
	int "Environment publish interval (seconds)"
	default 30
	range 5 3600

config APP_ENV_SAMPLE_INTERVAL_S
	int "BME688 sensor sample interval (seconds)"
	default 10
	range 1 3600

# ---- Location ----

config APP_GNSS_INTERVAL_S
	int "Interval between automatic location fixes (seconds)"
	default 600
	range 0 65535

config APP_GNSS_TIMEOUT_S
	int "Give up on an automatic GNSS fix after (seconds)"
	default 300

config APP_FIXED_LAT
	string "Manual location: latitude (decimal degrees, empty = off)"
	default ""

config APP_FIXED_LON
	string "Manual location: longitude (decimal degrees, empty = off)"
	default ""

config APP_FIXED_LOCATION_ALWAYS
	bool "Do not run GNSS/Wi-Fi/cell location (manual location only)"
	default n

config APP_LOCATION_WIFI_FIRST
	bool "Try Wi-Fi before GNSS"
	default y

endmenu

source "Kconfig.zephyr"
