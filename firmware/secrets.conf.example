# Copy this file to secrets.conf (exact name, no .txt) and fill in your values.
# secrets.conf is listed in .gitignore - never share or commit it.

# Password of the "thingy91x" MQTT user (created with mosquitto_passwd on the server)
CONFIG_O2_MQTT_PASSWORD="put-the-thingy91x-password-here"

# Mikrus VPS MQTT endpoint.
CONFIG_O2_MQTT_HOST="srv72.mikr.us"
CONFIG_O2_MQTT_PORT=40022
